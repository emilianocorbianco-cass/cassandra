rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isGroupAdmin(groupId) {
      return signedIn()
        && get(/databases/$(database)/documents/groups/$(groupId)).data.adminUid == request.auth.uid;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    // /users/{uid} — solo il proprietario può scrivere
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // /groups/{groupId} — autenticati possono leggere (per join by code)
    // solo admin può modificare campi del gruppo
    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn()
                    && (resource.data.adminUid == request.auth.uid
                        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'updatedAt']));

      // /groups/{groupId}/members/{uid}
      // un utente può aggiungersi (join) o rimuoversi (leave)
      // admin può gestire qualsiasi membro
      match /members/{memberUid} {
        allow read: if signedIn();
        allow create: if signedIn()
                      && request.auth.uid == memberUid;
        allow update: if signedIn()
                      && (request.auth.uid == memberUid
                          || isGroupAdmin(groupId));
        allow delete: if signedIn()
                      && (request.auth.uid == memberUid
                          || isGroupAdmin(groupId));
      }

      // /groups/{groupId}/chatMessages/{messageId}
      // chat interna al gruppo: leggono/scrivono solo i membri
      match /chatMessages/{messageId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
                      && request.resource.data.senderUid == request.auth.uid;
        allow update: if false;
        allow delete: if isGroupAdmin(groupId)
                      || (signedIn() && resource.data.senderUid == request.auth.uid);
      }
    }

    // /picks/{docId} — solo il proprietario (uid nel doc) può scrivere
    // autenticati possono leggere (per classifica)
    match /picks/{docId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
                    && resource.data.uid == request.auth.uid;
    }

    // /seasons/{seasonKey}/matchdays/{dayNumber}
    // autenticati possono leggere e scrivere (last-writer-wins per MVP)
    match /seasons/{seasonKey}/matchdays/{dayNumber} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // /seasons/{seasonKey}/standings/{docId}
    // classifica Serie A cache backend (readonly per client)
    match /seasons/{seasonKey}/standings/{docId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
  }
}
